{
	"name": "iobroker.truenas",
	"version": "0.5.0",
	"description": "Monitor TrueNAS SCALE devices via the official JSON-RPC 2.0 WebSocket API",
	"author": {
		"name": "U.R.D.L",
		"email": "claude@preindl.at"
	},
	"contributors": [],
	"homepage": "https://github.com/urdl/ioBroker.truenas",
	"license": "MIT",
	"keywords": [
		"truenas",
		"nas",
		"storage",
		"pool",
		"zfs",
		"smart"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/urdl/ioBroker.truenas.git"
	},
	"engines": {
		"node": ">= 22"
	},
	"dependencies": {
		"@iobroker/adapter-core": "^3.4.3",
		"@truenas/api-client": "^8.0.0",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@alcalzone/release-script": "^5.2.1",
		"@alcalzone/release-script-plugin-iobroker": "^5.2.0",
		"@alcalzone/release-script-plugin-license": "^5.2.2",
		"@alcalzone/release-script-plugin-manual-review": "^5.2.0",
		"@iobroker/adapter-dev": "^1.5.0",
		"@iobroker/eslint-config": "^2.3.4",
		"@iobroker/testing": "^6.3.0",
		"nyc": "^18.0.0"
	},
	"main": "main.js",
	"files": [
		"admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
		"admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
		"lib/",
		"!lib/**/*.test.js",
		"www/",
		"io-package.json",
		"LICENSE",
		"main.js"
	],
	"scripts": {
		"test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
		"test:package": "mocha test/package --exit",
		"test:integration": "mocha test/integration --exit",
		"test": "npm run test:js && npm run test:package",
		"lint": "eslint -c eslint.config.mjs .",
		"translate": "translate-adapter",
		"release": "release-script"
	},
	"nyc": {
		"include": [
			"src/**/*.ts"
		],
		"exclude": [
			"src/**/*.test.ts"
		],
		"extension": [
			".ts"
		],
		"require": [
			"ts-node/register"
		],
		"reporter": [
			"text-summary",
			"html"
		],
		"sourceMap": true,
		"instrument": true
	},
	"bugs": {
		"url": "https://github.com/urdl/ioBroker.truenas/issues"
	},
	"readmeFilename": "README.md"
}
